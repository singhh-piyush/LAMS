# Copy this file to .env and fill in your own values.
# .env is git-ignored, so real passwords never reach the repository.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lams_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Hosted only (Vercel + Supabase) - leave these commented out on your own PC.
# When DATABASE_URL is set it is used instead of the DB_* lines above.
# Any # in the password must be written as %23.
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# COOKIE_SECURE=true

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_any_long_random_string

# --- Email (optional - the default works with no account) ---
# console  = print the reset link into this terminal. Default. Nothing to set up.
# mailtrap = catch the mail in a Mailtrap sandbox inbox you can open in a browser.
# smtp     = real email through Gmail (see "Real email (Gmail)" in README.md)
MAIL_TRANSPORT=console
MAIL_FROM=noreply@lams.local
MAIL_FROM_NAME=LAMS Lab System

# Only needed if you set MAIL_TRANSPORT=mailtrap above.
# Sign up free at https://mailtrap.io, then Email Testing -> Inboxes -> My Inbox.
#   MAILTRAP_INBOX_ID is the number in the inbox URL:
#       https://mailtrap.io/inboxes/3971842/messages   ->  3971842
#   MAILTRAP_TOKEN is on the inbox's Integrations tab, with API chosen in the
#   dropdown (also under Settings -> API Tokens).
# Restart the server after changing these - .env is only read at startup.
# Full walkthrough is in README.md under "Email setup (Mailtrap)".
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_INBOX_ID=your_inbox_id

# Needed only when MAIL_TRANSPORT=smtp. Set MAIL_FROM to the same Gmail address.
# SMTP_PASS is the 16-letter Gmail App Password, NOT the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=darklingclips@gmail.com
SMTP_PASS=
