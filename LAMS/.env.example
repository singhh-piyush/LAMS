# Copy this file to .env and fill in your own values.
# .env is git-ignored, so real passwords never reach the repository.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lams_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change_this_to_any_long_random_string

# --- Email ---
# console  = print the reset link to the terminal (default, no account needed)
# mailtrap = capture mail in the Mailtrap sandbox inbox (what we demo with)
# smtp     = any normal SMTP server (Mailtrap SMTP, Gmail App Password, ...)
MAIL_TRANSPORT=console
MAIL_FROM=noreply@lams.local
MAIL_FROM_NAME=LAMS Lab System

# Needed only when MAIL_TRANSPORT=mailtrap
MAILTRAP_TOKEN=your_mailtrap_api_token
MAILTRAP_INBOX_ID=your_inbox_id

# Needed only when MAIL_TRANSPORT=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
